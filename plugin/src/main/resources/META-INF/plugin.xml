<idea-plugin>
    <id>dev.conduit</id>
    <name>Conduit</name>
    <vendor>William Fernandes</vendor>

    <description><![CDATA[
        Bring your own agent: Conduit runs the AI coding CLI you already have installed
        (Claude Code, Codex CLI, Gemini CLI, OpenCode and any ACP-compatible agent) inside the IDE,
        with native diffs, approvals and IDE tools exposed to the agent over a local MCP server.
        <ul>
          <li>Chat with streaming answers, the files each turn changed, apply, revert and compare</li>
          <li>Agent tasks: plan, step-by-step execution, verification by the IDE, git worktrees</li>
          <li>Task board with parallel agents and side-by-side comparison of two agents</li>
          <li>Code review of local changes, the branch or a pull request, with findings in the editor</li>
          <li>Context control with token budget, file management and quick actions</li>
          <li>Inline edits (Ctrl+I) and ghost-text autocomplete with a fast model you choose</li>
        </ul>
        Conduit never resells tokens and never sends your code to its own servers.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <dependencies>
        <module name="intellij.libraries.compose.runtime.desktop"/>
        <module name="intellij.libraries.compose.foundation.desktop"/>
        <module name="intellij.libraries.skiko"/>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
        <module name="intellij.platform.jewel.markdown.core"/>
        <module name="intellij.platform.jewel.markdown.ideLafBridgeStyling"/>
    </dependencies>

    <resource-bundle>messages.ConduitBundle</resource-bundle>

    <extensionPoints>
        <!-- Lets optional parts of the plugin (language support, framework packs) add IDE tools for agents. -->
        <extensionPoint name="ideTool" interface="dev.conduit.mcp.ide.IdeTool" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- dynamic: the pages are children created by ConduitConfigurable, so their names follow Conduit's own language. -->
        <applicationConfigurable parentId="tools" id="dev.conduit.settings" instance="dev.conduit.ui.settings.ConduitConfigurable" dynamic="true"
                                 bundle="messages.ConduitBundle" key="settings.displayName"/>

        <toolWindow id="Conduit" anchor="right" icon="/icons/conduit.svg" factoryClass="dev.conduit.ui.ConduitToolWindowFactory"/>

        <notificationGroup id="Conduit" displayType="BALLOON" bundle="messages.ConduitBundle" key="notification.group"/>

        <statusBarWidgetFactory id="dev.conduit.status" implementation="dev.conduit.ui.status.ConduitStatusBarWidgetFactory" order="first"/>

        <postStartupActivity implementation="dev.conduit.mcp.ide.tools.TestResultsStartup"/>
        <postStartupActivity implementation="dev.conduit.ui.ConduitStartup"/>

        <intentionAction>
            <language/>
            <className>dev.conduit.ui.actions.FixWithConduitIntention</className>
            <bundleName>messages.ConduitBundle</bundleName>
            <categoryKey>intention.family</categoryKey>
        </intentionAction>

        <inline.completion.provider implementation="dev.conduit.completion.ConduitInlineCompletionProvider"/>
        <actionPromoter implementation="dev.conduit.completion.AcceptPartialPromoter"/>
    </extensions>

    <actions resource-bundle="messages.ConduitBundle">
        <group id="dev.conduit.group" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="dev.conduit.openChat" class="dev.conduit.ui.actions.OpenChatAction" icon="/icons/conduit.svg"/>
            <action id="dev.conduit.sendSelection" class="dev.conduit.ui.actions.SendSelectionToChatAction">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift L"/>
            </action>
            <action id="dev.conduit.inlineChat" class="dev.conduit.ui.actions.InlineChatAction">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl I"/>
            </action>
            <action id="dev.conduit.switchAgent" class="dev.conduit.ui.actions.SwitchAgentAction">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt A"/>
            </action>
            <action id="dev.conduit.toggleCompletion" class="dev.conduit.completion.ToggleCompletionAction">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift C"/>
            </action>
        </group>
        <group id="dev.conduit.editor" popup="true" icon="/icons/conduit.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <reference ref="dev.conduit.inlineChat"/>
            <reference ref="dev.conduit.sendSelection"/>
            <separator/>
            <action id="dev.conduit.explain" class="dev.conduit.ui.actions.ExplainAction"/>
            <action id="dev.conduit.fix" class="dev.conduit.ui.actions.FixAction"/>
            <action id="dev.conduit.refactor" class="dev.conduit.ui.actions.RefactorAction"/>
            <action id="dev.conduit.optimize" class="dev.conduit.ui.actions.OptimizeAction"/>
            <action id="dev.conduit.document" class="dev.conduit.ui.actions.DocumentAction"/>
            <action id="dev.conduit.errorHandling" class="dev.conduit.ui.actions.ErrorHandlingAction"/>
            <action id="dev.conduit.generateTests" class="dev.conduit.ui.actions.GenerateTestsAction"/>
        </group>
        <action id="dev.conduit.acceptWord" class="dev.conduit.completion.AcceptWordAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl RIGHT"/>
        </action>
        <action id="dev.conduit.acceptLine" class="dev.conduit.completion.AcceptLineAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift RIGHT"/>
        </action>
        <action id="dev.conduit.commitMessage" class="dev.conduit.ui.actions.GenerateCommitMessageAction" icon="AllIcons.Actions.Lightning">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
